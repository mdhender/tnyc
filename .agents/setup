#!/usr/bin/env bash
set -euo pipefail

go_version="1.21.6"
go_archive="go${go_version}.linux-amd64.tar.gz"
go_checksum="3f934f40ac360b9c01f616a9aa1796d227d8b0328bf64cb045c7b8c4ee9caea4"
go_root="/usr/local/go"

log() {
	printf '[setup] %s\n' "$*"
}

if [[ ! -x "${go_root}/bin/go" ]] || [[ "$("${go_root}/bin/go" version)" != "go version go${go_version} linux/amd64" ]]; then
	log "installing Go ${go_version}"
	tmp_dir="$(mktemp -d)"
	trap 'rm -rf "$tmp_dir"' EXIT
	curl --fail --location --silent --show-error \
		"https://go.dev/dl/${go_archive}" \
		--output "${tmp_dir}/${go_archive}"
	printf '%s  %s\n' "$go_checksum" "${tmp_dir}/${go_archive}" | sha256sum --check --status
	rm -rf "$go_root"
	tar -C /usr/local -xzf "${tmp_dir}/${go_archive}"
else
	log "Go ${go_version} is already installed"
fi

ln -sfn "${go_root}/bin/go" /usr/local/bin/go
ln -sfn "${go_root}/bin/gofmt" /usr/local/bin/gofmt
export PATH="/usr/local/bin:${PATH}"

log "downloading Go module dependencies"
go mod download

log "verifying the repository"
go test ./...

log "complete"
